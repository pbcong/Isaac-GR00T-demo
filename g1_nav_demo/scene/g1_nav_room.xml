<mujoco model="g1_nav_room">
  <include file="g1_29dof.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <statistic center="0 0 0.7" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offheight="960" offwidth="1280"/>
  </visual>

  <default>
    <default class="furniture">
      <geom contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.2" width="512" height="3072"/>
    <texture type="2d" name="gridfloor" builtin="checker" mark="edge" rgb1="0.25 0.25 0.25" rgb2="0.3 0.3 0.3"
      markrgb="0.5 0.5 0.5" width="300" height="300"/>
    <material name="gridfloor" texture="gridfloor" texuniform="true" texrepeat="10 10" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <light directional="true" pos="2 2 3" dir="-2 -2 -3" diffuse="0.4 0.4 0.4"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="gridfloor"/>

    <camera name="birdseye" pos="1.5 0 12" xyaxes="1 0 0 0 1 0" fovy="50"/>
    <camera name="head" pos="0.04 0 0.38" xyaxes="0 -1 0 0 0 1" fovy="75"/>


    <body name="table" pos="3 2 0">
      <geom name="table_top" type="box" size="0.6 0.4 0.025" pos="0 0 0.725" rgba="0.6 0.4 0.2 1" class="furniture"/>
      <geom name="table_leg_fl" type="cylinder" size="0.025 0.35" pos="0.5 0.3 0.35" rgba="0.55 0.35 0.15 1" class="furniture"/>
      <geom name="table_leg_fr" type="cylinder" size="0.025 0.35" pos="0.5 -0.3 0.35" rgba="0.55 0.35 0.15 1" class="furniture"/>
      <geom name="table_leg_bl" type="cylinder" size="0.025 0.35" pos="-0.5 0.3 0.35" rgba="0.55 0.35 0.15 1" class="furniture"/>
      <geom name="table_leg_br" type="cylinder" size="0.025 0.35" pos="-0.5 -0.3 0.35" rgba="0.55 0.35 0.15 1" class="furniture"/>
    </body>

    <body name="chair" pos="1 3 0">
      <geom name="chair_seat" type="box" size="0.25 0.25 0.03" pos="0 0 0.4" rgba="0.5 0.5 0.55 1" class="furniture"/>
      <geom name="chair_back" type="box" size="0.25 0.02 0.25" pos="0 0.23 0.65" rgba="0.5 0.5 0.55 1" class="furniture"/>
      <geom name="chair_leg_fl" type="cylinder" size="0.015 0.2" pos="0.2 -0.2 0.2" rgba="0.4 0.4 0.45 1" class="furniture"/>
      <geom name="chair_leg_fr" type="cylinder" size="0.015 0.2" pos="-0.2 -0.2 0.2" rgba="0.4 0.4 0.45 1" class="furniture"/>
      <geom name="chair_leg_bl" type="cylinder" size="0.015 0.2" pos="0.2 0.2 0.2" rgba="0.4 0.4 0.45 1" class="furniture"/>
      <geom name="chair_leg_br" type="cylinder" size="0.015 0.2" pos="-0.2 0.2 0.2" rgba="0.4 0.4 0.45 1" class="furniture"/>
    </body>

    <body name="door" pos="5 0 0">
      <geom name="door_frame" type="box" size="0.05 0.5 1.1" pos="0 0 1.35" rgba="0.6 0.4 0.2 1" class="furniture"/>
    </body>

    <body name="bookshelf" pos="-2 1 0">
      <geom name="bookshelf_body" type="box" size="0.25 0.5 0.9" pos="0 0 0.9" rgba="0.6 0.4 0.2 1" class="furniture"/>
    </body>

    <body name="crate" pos="2.0 0.0 0">
      <geom name="crate" type="box" size="0.3 0.3 0.5" pos="0 0 0.5"
            rgba="0.55 0.4 0.2 1" contype="1" conaffinity="1"/>
    </body>

    <body name="barrel" pos="0.5 -1.5 0">
      <geom name="barrel" type="cylinder" size="0.2 0.5" pos="0 0 0.5"
            rgba="0.3 0.3 0.6 1" contype="1" conaffinity="1"/>
    </body>

    <body name="pillar" pos="-0.5 2.0 0">
      <geom name="pillar" type="cylinder" size="0.15 0.75" pos="0 0 0.75"
            rgba="0.7 0.7 0.7 1" contype="1" conaffinity="1"/>
    </body>

    <body name="moving_human" pos="1.5 -2.5 0.9">
      <freejoint name="human_freejoint"/>
      <geom name="human_body" type="cylinder" size="0.35 0.9"
            rgba="0.7 0.5 0.3 1" contype="1" conaffinity="1"/>
    </body>

  </worldbody>
</mujoco>